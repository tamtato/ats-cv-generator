---
import { Icon } from 'astro-icon/components';

interface Props {
    href?: string;
    text?: string;
    icon?: string;
}

const { href, text, icon, ...rest } = Astro.props;
const Element = href ? 'a' : 'button';
---

<Element
    href={href}
    target={href ? '_blank' : undefined}
    class="flex items-center gap-2 text-sm text-gray-800 hover:text-indigo-600 transition-colors cursor-pointer tracking-widest print:hidden"
    {...rest}
>
    <slot name="icon" />
    {icon && <Icon name={icon} class="w-6 h-6" />}
    <span class="hidden xl:inline-block">{text}</span>
</Element>