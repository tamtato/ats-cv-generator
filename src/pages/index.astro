---
import '../styles/global.css';
import EditorSidebar from '../components/EditorSidebar/EditorSidebar.vue';
import DownloadPdfButton from "../components/EditorSidebar/DownloadPdfButton.vue";

import PageHeader from "../components/PageHeader/PageHeader.astro";
import CvPreview from '../components/CvPreview/CvPreview.vue';
---

<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>ATS CV Generator</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&family=Roboto+Mono:ital,wght@0,100..700;1,100..700&display=swap" rel="stylesheet"></head>


<body class="bg-gray-100 m-0 p-0 font-body relative h-screen overflow-hidden print:block print:p-0 print:bg-white print:h-auto print:overflow-visible">

<main class="w-full relative h-full flex print:m-0 print:block print:h-auto">
	<div class="flex-1 flex flex-col gap-6 p-6 print:hidden">
		<PageHeader />
		<EditorSidebar client:only="vue" />
	</div>

	<div class=" h-full overflow-y-auto relative">
		<CvPreview client:only="vue" />
	</div>
</main>


</body>
</html>