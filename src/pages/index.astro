---
import '../styles/global.css';
import EditorSidebar from '../components/EditorSidebar/EditorSidebar.vue';
import PageHeader from "../components/PageHeader/PageHeader.astro";
import CvPreview from '../components/CvPreview/CvPreview.vue';
---

<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>ATS CV Generator</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&family=Roboto+Mono:ital,wght@0,100..700;1,100..700&display=swap" rel="stylesheet"></head>
<body class="m-0 p-0 h-screen">

<main class="h-full w-full bg-gray-100 p-3 lg:p-6 flex flex-col lg:flex-row flex-1 overflow-hidden relative font-body print:p-0 print:bg-white print:overflow-visible print:block print:h-auto">
	<div class="w-full xl:w-3/5 flex flex-col gap-2 print:hidden">
		<PageHeader />
		<EditorSidebar client:only="vue" />
	</div>
	<CvPreview client:only="vue" />

</main>
</body>
</html>