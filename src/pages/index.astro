---
import '../styles/global.css';
import EditorSidebar from '../components/EditorSidebar/EditorSidebar.vue';
import PaginatedPreview from '../components/PaginatedPreview.vue';
import AtsRealitiesModal from "../components/AtsRealitiesModal.astro";
---

<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>ATS CV Generator</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Lato:wght@400;700&family=Montserrat:wght@400;600;700&family=Open+Sans:wght@400;600;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
</head>
<body class="bg-gray-300 m-0 p-0 font-sans h-screen overflow-hidden print:bg-white print:h-auto print:overflow-visible">
<main class="grid grid-cols-1 md:grid-cols-12 h-full print:block print:h-auto">
	<!-- Left Sidebar (Hidden on Print) -->
	<aside class="md:col-span-6 lg:col-span-5 bg-white border-r border-gray-300 p-6 overflow-y-auto h-full print:hidden shadow-lg z-10 relative flex flex-col gap-6">
		<AtsRealitiesModal />
		<!-- Editor Tools -->
		<EditorSidebar client:only="vue" />
	</aside>
	<!-- CV Preview Area -->
	<section class="md:col-span-6 lg:col-span-7 h-full overflow-y-auto print:block">
		<PaginatedPreview client:only="vue" />
	</section>
</main>
</body>
</html>